@page "/"

<PageTitle>Inicio</PageTitle>

<h1>Sistema de Gestión</h1>
<p class="lead">Administrá categorías, proveedores y productos desde un solo lugar.</p>

<div class="row g-3">
    <div class="col-md-4">
        <a href="categorias" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center py-4">
                    <i class="bi bi-tags-fill fs-1 text-primary"></i>
                    <h5 class="mt-3 text-dark">Categorías</h5>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="proveedores" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center py-4">
                    <i class="bi bi-truck fs-1 text-primary"></i>
                    <h5 class="mt-3 text-dark">Proveedores</h5>
                </div>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="productos" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center py-4">
                    <i class="bi bi-box-seam-fill fs-1 text-primary"></i>
                    <h5 class="mt-3 text-dark">Productos</h5>
                </div>
            </div>
        </a>
    </div>
</div>